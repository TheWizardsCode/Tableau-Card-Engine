##################################
# Test / Coverage
##################################
coverage/
test-results/

##################################
# Runtime Data (transcripts, screenshots, etc.)
##################################
# Temporary runtime artifacts used by tests and local runs - do not commit
tmp/
data/
results/

# Per-test visual regression / Playwright screenshot artifacts
# These are generated during tests and should not be committed.
tests/**/__screenshots__/

# Local debug artifacts
artifacts/
debug-page.png
debug-playwright.cjs
debug-playwright.js
tui-debug.log

##################################
Worklog Specific Ignores
##################################

# Ignore Worklog directory by default
.worklog/

# Keep defaults and plugins tracked
!.worklog/config.defaults.yaml
!.worklog/plugins/
!.worklog/plugins/**

# opencode temporary files
.opencode/tmp/

### End of Worklog Specific Ignores

# herdr server runtime flag (created/removed by the herdr server process;
# keep it out of git status so release/hygiene gates see a clean tree)
.herdr-downtime-disabled
# Ignore local pi settings but track project-level agent skills
.pi/*
!.pi/skills/
!.pi/skills/**
!.pi/test-config.json
# Track the local skill-extension contract (project-level agent tooling that
# must be committed and testable, e.g. the test-skill `--type` profile map).
!.pi/skills_extensions/
!.pi/skills_extensions/**
.implement_state.json

# Private Steam credentials for the launcher — never commit (see
# electron/steam-config.example.json for the shape).
electron/steam-config.local.json

# Steamworks SDK bootstrap file (real app id) — never commit.
steam_appid.txt
