##################################
# Runtime Data (transcripts, screenshots, etc.)
##################################
# Temporary runtime artifacts used by tests and local runs - do not commit
tmp/
data/
results/

# Per-test visual regression / Playwright screenshot artifacts
# These are generated during tests and should not be committed.
tests/**/__screenshots__/

# Local debug artifacts
debug-page.png
debug-playwright.cjs
debug-playwright.js
tui-debug.log

##################################
Worklog Specific Ignores
##################################

# Ignore Worklog directory by default
.worklog/

# Keep defaults and plugins tracked
!.worklog/config.defaults.yaml
!.worklog/plugins/
!.worklog/plugins/**

# opencode temporary files
.opencode/tmp/

### End of Worklog Specific Ignores
