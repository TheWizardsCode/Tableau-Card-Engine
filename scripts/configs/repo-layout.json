  "assetDecisionTable": [
    {
      "asset": "CREDITS.md",
      "owner": "core",
      "rationale": "Asset attribution index for the shared deck, default SFX and every game's assets; stays with the shared asset tree and is extended when a game moves out."
    },
    {
      "asset": "cards/",
      "owner": "core",
      "rationale": "Canonical 52-card deck (SVGCards Vertical2, Public Domain) plus card_back.svg; shared by Gym, Golf, Blackjack and the Card System tests. Note: the shared include must NOT be a parent of a game-owned card dir; cards/lost-cities/ is owned by lost-cities and is not covered by this entry."
    },
    {
      "asset": "cards/alternative/",
      "owner": "core",
      "rationale": "Webisso MIT 'Modern' deck is a core-provided alternative card design, referenced from Card System docs and Gym; not owned by any single game."
    },
    {
      "asset": "cards/lost-cities/",
      "owner": "lost-cities",
      "rationale": "61 expedition-specific SVGs generated by scripts/generate-lost-cities-cards.ts; used only by the Lost Cities game."
    },
    {
      "asset": "audio/default/",
      "owner": "core",
      "rationale": "Shared default SFX set (card-draw/flip/swap/discard, round-end, score-reveal, turn-change, ui-click, plus game-win, game-lost, illegal-move), referenced via 'assets/audio/default/*' by Gym, Golf, Beleaguered Castle, Lost Cities, Main Street and Coloretto."
    },
    {
      "asset": "audio/",
      "owner": "core",
      "rationale": "The handful of legacy root-level shared SFX (card-discard/card-draw/card-flip/card-swap/round-end/score-reveal/turn-change/ui-click.wav) referenced directly via 'assets/audio/<name>.wav' by earlier games. Represented in the layout as explicit file entries under a shared 'audio/' rule so per-game audio subdirectories are excluded by not being listed; see 'audioRootShared'."
    },
    {
      "asset": "audio/beleaguered-castle/",
      "owner": "beleaguered-castle",
      "rationale": "14 castle-themed SFX generated by scripts/generate-castle-sfx.mjs for this game only."
    },
    {
      "asset": "audio/blackjack/",
      "owner": "blackjack",
      "rationale": "9 blackjack SFX referenced only by the Blackjack scene."
    },
    {
      "asset": "audio/coloretto/",
      "owner": "coloretto",
      "rationale": "5 coloretto SFX referenced only by the Coloretto scene."
    },
    {
      "asset": "audio/feudalism/",
      "owner": "feudalism",
      "rationale": "6 feudalism SFX referenced only by the Feudalism scene."
    },
    {
      "asset": "audio/golf/",
      "owner": "golf",
      "rationale": "10 golf SFX generated by scripts/generate-sfx.mjs for the Golf game."
    },
    {
      "asset": "audio/lost-cities/",
      "owner": "lost-cities",
      "rationale": "12 expedition-themed SFX generated by scripts/generate-lost-cities-sfx.mjs for Lost Cities."
    },
    {
      "asset": "audio/sushi-go/",
      "owner": "sushi-go",
      "rationale": "6 sushi-go SFX referenced only by the Sushi Go scene."
    },
    {
      "asset": "games/",
      "owner": "core",
      "rationale": "Container for per-game output directories (thumbnails and game-scoped sub-trees). Each per-game child moves with its game; a game repo re-creates its own games/<game>/ directory."
    },
    {
      "asset": "games/main-street/",
      "owner": "main-street",
      "rationale": "190 files: main-street card SVGs (svg/cards), icons (svg/icons) and game audio; generated by scripts/generate-main-street-card-*.mjs and used only by Main Street."
    },
    {
      "asset": "sushi-go/",
      "owner": "sushi-go",
      "rationale": "14 in-house SVG icons plus STYLE.md and preview.html for the Sushi Go game only."
    }
  ],
  "notes": {
    "historyPreservation": "git-filter-repo --path <path>; preserves commit history for moved files.",
    "siblingLayout": "Per-game repos and the core repo are checked out as siblings; a game repo pulls the core as a git submodule at ./core.",
    "assetIncludeSemantics": "git filter-repo directory includes re-include their children and glob '*' crosses '/', so a shared asset is NEVER declared as a broad parent of a game-owned child. Rather than exclude, the layout enumerates the shared files and the disjoint shared subtrees (cards/alternative/, audio/default/) explicitly; game-owned subdirectories are simply absent.",
    "crossBoundaryFixes": [
      "example-games/gym/scenes/GymTokenPileViewScene.ts loads 'assets/cards/classic-vector/back.png', which does not exist in public/assets. Retarget the Gym demo to the shared card_back.svg ('assets/cards/card_back.svg') so the Gym depends only on core-owned assets.",
      "example-games/gym/scenes/GymSvgHelpersScene.ts loads 'assets/sushi-go/icon-tempura.svg' (a game-owned asset). Retarget the Gym demo to a core-owned SVG so the Gym does not depend on a game repo."
    ],
    "sharedCardsCount": 53,
    "sharedRootAudioCount": 8
  }
