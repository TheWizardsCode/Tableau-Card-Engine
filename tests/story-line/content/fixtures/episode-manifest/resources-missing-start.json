          "outcomeRules": [
            {
              "id": "stores-kept",
              "when": {
                "objective": "met"
              },
              "outcome": "success"
            },
            {
              "id": "stores-spent",
              "outcome": "partial"
            }
          ],
          "routes": [
            {
              "id": "honour-the-answer",
              "on": "*",
              "to": {
                "kind": "chain"
              }
            }
          ]
        }
      ]
