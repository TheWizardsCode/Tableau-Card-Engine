      "id": "act-iii",
      "title": "The Core",
      "order": 3,
      "entryScene": "s-iii-core",
      "scenes": [
        {
          "id": "s-iii-core",
          "title": "The Core",
          "objective": {
            "statement": "Reach the core with the crew still behind you.",
            "check": {
              "field": "morale",
              "op": ">=",
              "value": 4
            }
          },
          "budget": {
            "clock": 5
          },
          "entryBeat": "le-iii-approach",
          "beats": [
            {
              "cardId": "le-iii-approach",
              "clockCost": 3
            },
            {
              "cardId": "le-iii-ahead",
