        {
          "id": "s-i-open",
          "title": "The First Unwriting",
          "objective": {
            "statement": "End the watch with the survey's stores intact.",
            "check": {
              "field": "stores",
              "op": ">=",
              "value": 3
            }
          },
          "budget": {
            "clock": 2
          },
          "entryBeat": "le-i-open",
