{
  "name": "tableau-card-engine",
  "version": "0.1.19",
  "description": "Tableau Card Engine (TCE) -- a modular game engine for building single-player tableau card games using Phaser 4 RC and TypeScript",
  "author": "TheWizardsCode",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "build:electron": "tsc --noEmit && vite build --mode electron",
    "preview": "vite preview --host",
    "test": "bash scripts/run-ci-tests.sh",
    "test:smoke": "bash scripts/run-smoke-tests.sh",
    "test:dev": "bash scripts/run-dev-tests.sh",
    "context:check": "bash scripts/refresh-context-thresholds.sh --check",
    "context:refresh": "bash scripts/refresh-context-thresholds.sh",
    "balance-cards": "tsx ../tce-main-street/src/scripts/run-balance-cards.ts",
    "monte-carlo": "vite-node ../tce-main-street/src/scripts/monte-carlo.ts --seeds 200 --seed-prefix mc-balance --maxTurns 25 --strategy greedy --out results/main-street-monte-carlo.json --csv-out results/main-street-monte-carlo.csv",
    "monte-carlo-sweep": "vite-node ../tce-main-street/src/scripts/monte-carlo.ts --sweep --seeds 100 --seed-prefix mc-balance --maxTurns 25 --out results/sweep.json --csv-out results/sweep.csv",
    "replay": "tsx scripts/replay.ts",
    "publish:repos": "tsx scripts/publish-repos.ts",
    "setup:distribution": "tsx scripts/setup-distribution.ts",
    "scaffold:game": "tsx scripts/game-repo-scaffold.ts",
    "scaffold:games": "tsx scripts/game-repo-scaffold.ts --all --core-root . --repos-dir ..",
    "transcripts:export": "tsx scripts/export-transcripts.ts",
    "save-load-smoke": "vite-node ../tce-main-street/src/scripts/save-load-smoke.ts",
    "tf:generate": "scripts/tf-generate-synths.sh",
    "build:electron-main": "node scripts/build-electron-main.mjs",
    "build:steam-friends": "node scripts/build-steam-friends.mjs",
    "start:electron": "npm run build:electron && npm run build:electron-main && electron .",
    "package": "npm run build:electron && npm run build:electron-main && electron-builder --publish never",
    "package:win": "npm run build:electron && npm run build:electron-main && electron-builder --win --publish never",
    "package:linux": "npm run build:electron && npm run build:electron-main && electron-builder --linux --publish never",
    "package:mac": "npm run build:electron && npm run build:electron-main && electron-builder --mac --publish never",
    "balance:drift-report": "vite-node ../tce-main-street/src/scripts/balance/drift-report.ts",
    "package:steam": "node scripts/check-steamworks.mjs && node scripts/check-steam-friends.mjs && npm run build:electron && npm run build:electron-main && electron-builder --win --publish never"
  },
  "dependencies": {
    "@types/semver": "^7.8.0",
    "phaser": "4.0.0-rc.7",
    "semver": "^7.7.4",
    "steamworks.js": "^0.4.0"
  },
  "devDependencies": {
    "@types/node": "^25.3.0",
    "@typescript-eslint/eslint-plugin": "^8.58.2",
    "@typescript-eslint/parser": "^8.58.2",
    "@vitest/browser": "^3.2.4",
    "ajv": "^8.12.0",
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3",
    "eslint": "^10.2.1",
    "eslint-config-prettier": "^10.1.8",
    "playwright": "^1.58.2",
    "prettier": "^3.8.3",
    "sharp": "^0.33.0",
    "tone": "^15.1.22",
    "tsx": "^4.21.0",
    "typescript": "^5.7.0",
    "vite": "^6.1.0",
    "vitest": "^3.0.0"
  },
  "license": "MIT",
  "main": "dist-electron/main.js"
}
